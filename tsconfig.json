{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["es2023", "esnext.disposable"],
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
