# dependencies (the plugin itself has none, but a checkout may be pnpm-linked)
node_modules/

# TypeScript build output (compiled at release time, not committed)
dist/
dist-test/

# test scratch: throwaway repos, shim packages, tree data
test/.tmp/

# runtime data must never be committed (it lives in $DSH_HOME, not here)
tree.json

# publish credentials: an isolated npm userconfig holding an access token
.npmrc.publish

# editor / OS noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
